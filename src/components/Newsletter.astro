---
/**
 * Newsletter signup. Posts to /api/subscribe (netlify/functions/subscribe.mjs),
 * which adds the address to the Laposta list with double opt-in.
 * With JavaScript the answer appears in place; without it the visitor lands
 * on /newsletter/thank-you/ or /newsletter/error/. No cookies or tracking.
 */
import { getContent } from "../lib/content";

const { gallery } = await getContent();
---

<section class="container section" aria-labelledby="newsletter-label">
  <div class="split">
    <h2 class="label" id="newsletter-label">Newsletter</h2>
    <div>
      <form class="form" method="post" action="/api/subscribe" data-newsletter novalidate>
        <label for="newsletter-email" class="visually-hidden">Email address</label>
        <input
          id="newsletter-email"
          name="email"
          type="email"
          autocomplete="email"
          inputmode="email"
          placeholder="Email address"
          required
          aria-describedby="newsletter-message"
        />
        <div class="hp" aria-hidden="true">
          <label for="newsletter-website">Leave this field empty</label>
          <input id="newsletter-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <button class="button" type="submit">Subscribe</button>
      </form>
      <p
        id="newsletter-message"
        class="message"
        role="status"
        aria-live="polite"
        data-newsletter-message
        data-email={gallery.email}
      >
      </p>
    </div>
  </div>
</section>

<script>
  const messages = {
    ok: "Thank you. Check your inbox to confirm.",
    invalid: "Please enter a valid email address.",
    unavailable: "Sorry, something went wrong. Please try again later.",
  };

  for (const form of document.querySelectorAll<HTMLFormElement>("[data-newsletter]")) {
    const message = form.parentElement?.querySelector<HTMLElement>("[data-newsletter-message]");
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
    const input = form.querySelector<HTMLInputElement>("input[name=email]");
    if (!message || !button || !input) continue;

    const show = (text: string, error: boolean) => {
      message.textContent = text;
      message.classList.toggle("is-error", error);
      input.setAttribute("aria-invalid", String(error));
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!input.checkValidity()) {
        show(messages.invalid, true);
        input.focus();
        return;
      }
      button.disabled = true;
      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        const data = await response.json().catch(() => ({ ok: false, reason: "unavailable" }));
        if (data.ok) {
          form.hidden = true;
          show(messages.ok, false);
          message.classList.add("is-done");
          message.setAttribute("tabindex", "-1");
          message.focus();
        } else {
          show(messages[data.reason as keyof typeof messages] ?? messages.unavailable, true);
        }
      } catch {
        show(messages.unavailable, true);
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .form {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    max-width: 760px;
  }
  input[type="email"] {
    flex: 1 1 260px;
    min-height: 44px;
    padding: 0 0 0 2px;
    border: 0;
    border-bottom: 1px solid var(--text);
    border-radius: 0;
    background: transparent;
    font-family: inherit;
    font-size: 19px;
    color: var(--text);
  }
  input[type="email"]::placeholder {
    color: var(--muted);
    opacity: 1;
  }
  input[type="email"]:focus-visible {
    outline-offset: 4px;
  }
  .form[hidden] {
    display: none;
  }
  .button:disabled {
    cursor: wait;
    opacity: 0.6;
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .message:empty {
    display: none;
  }
  .message {
    margin-top: 16px;
    max-width: 760px;
    font-size: 15px;
    color: var(--body);
  }
  .message.is-error {
    color: var(--text);
  }
  .message.is-error::before {
    content: "— ";
  }
  .message.is-done {
    margin-top: 0;
    font-size: clamp(22px, 2.4vw, 26px);
    font-weight: 500;
    line-height: 1.3;
    color: var(--text);
  }
  .message:focus {
    outline: none;
  }
</style>
