---
import { artistOf, artistUrl, enquiryHref, sizeLabel } from "../lib/content";
import type { Artwork } from "../lib/types";

interface Props {
  work: Artwork;
  /** Show the artist name as a link (Art page). */
  showArtist?: boolean;
  /** Show price line and ENQUIRE (Art and Artist pages). */
  showStatus?: boolean;
  headingLevel?: "h2" | "h3";
}

const { work, showArtist = false, showStatus = false, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
const artist = artistOf(work);
---

<div class="caption">
  <Heading class="title">{work.title}</Heading>
  {showArtist && <a class="artist" href={artistUrl(artist)}>{artist.name}</a>}
  <p class="meta">{work.medium} · {sizeLabel(work)}</p>
  {
    showStatus && (
      <div class="status">
        {work.status === "available" && (
          <>
            <span>Price on request</span>
            <a class="enquire" href={enquiryHref(work)}>
              Enquire<span class="visually-hidden"> about {work.title}</span>
            </a>
          </>
        )}
        {work.status === "reserved" && <span>Reserved</span>}
        {work.status === "sold" && (
          <span class="sold">
            <span class="dot" aria-hidden="true" />
            Sold
          </span>
        )}
      </div>
    )
  }
</div>

<style>
  .caption {
    padding-top: 16px;
    font-size: 15px;
  }
  .title {
    font-size: 18px;
    font-weight: 500;
    line-height: 1.3;
  }
  .artist {
    display: inline-block;
    margin-top: 2px;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: color 0.15s;
  }
  .artist:hover {
    color: var(--muted);
  }
  .meta {
    margin-top: 4px;
    color: var(--muted);
  }
  .status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 16px;
    margin-top: 12px;
    border-top: 1px solid var(--line);
    min-height: 44px;
  }
  .enquire {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
    transition: color 0.15s;
  }
  .enquire:hover {
    color: var(--muted);
  }
  .sold {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--text);
  }
</style>
