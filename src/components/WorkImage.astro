---
import { Picture } from "astro:assets";
import { sizeLabel } from "../lib/content";
import { srcProps } from "../lib/image";
import type { Artwork } from "../lib/types";

interface Props {
  work: Artwork;
  artistName: string;
  sizes: string;
  widths: number[];
  eager?: boolean;
}

const { work, artistName, sizes, widths, eager = false } = Astro.props;
const alt = work.placeholder
  ? `Photo of ${work.title} by ${artistName} to follow`
  : `${work.title} by ${artistName}, ${work.medium.toLowerCase()}, ${sizeLabel(work)}`;
// Never generate sizes larger than the original photo.
const usable = widths.filter((w) => w <= work.image.width);
const finalWidths = usable.length ? usable : [work.image.width];
---

<div class:list={["work-media", { "is-placeholder": work.placeholder }]} id={work.slug}>
  <Picture
    {...srcProps(work.image)}
    alt={alt}
    formats={["avif"]}
    fallbackFormat="webp"
    widths={finalWidths}
    sizes={sizes}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
  />
</div>

<style>
  .work-media {
    position: relative;
    scroll-margin-top: 24px;
  }
  .work-media :global(img) {
    width: 100%;
    height: auto;
  }
  .is-placeholder::after {
    content: "Image to follow";
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    text-align: center;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
