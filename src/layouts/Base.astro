---
import "@fontsource/inter-tight/400.css";
import "@fontsource/inter-tight/500.css";
import "@fontsource/inter-tight/600.css";
import "../styles/global.css";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { absoluteUrl, breadcrumbJsonLd, galleryJsonLd, type Crumb } from "../lib/seo";
import { getArtwork } from "../lib/content";

interface Props {
  title: string;
  description: string;
  /** Share image; defaults to Distance. */
  shareImage?: ImageMetadata;
  shareAlt?: string;
  breadcrumbs?: Crumb[];
  jsonLd?: object[];
  /** Image to preload (hero). */
  preload?: { srcset: string; sizes: string; type: string } | undefined;
}

const { title, description, breadcrumbs, jsonLd = [], preload } = Astro.props;
const fallback = getArtwork("distance");
const share = await getImage({
  src: Astro.props.shareImage ?? fallback.image,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpg",
});
const shareAlt = Astro.props.shareAlt ?? `${fallback.title}, oil on canvas, by Julián Villafañe`;
const canonical = absoluteUrl(Astro.url.pathname);
const shareUrl = absoluteUrl(share.src);
const structured = [
  galleryJsonLd(),
  ...(breadcrumbs ? [breadcrumbJsonLd(breadcrumbs)] : []),
  ...jsonLd,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      preload && (
        <link
          rel="preload"
          as="image"
          imagesrcset={preload.srcset}
          imagesizes={preload.sizes}
          type={preload.type}
          fetchpriority="high"
        />
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Daily Dose Gallery" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareAlt} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareUrl} />
    <meta name="twitter:image:alt" content={shareAlt} />

    {structured.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
