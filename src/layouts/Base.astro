---
import "@fontsource/inter-tight/400.css";
import "@fontsource/inter-tight/500.css";
import "@fontsource/inter-tight/600.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { artistOf, findArtwork, getContent } from "../lib/content";
import {
  absoluteUrl,
  breadcrumbJsonLd,
  galleryJsonLd,
  shareImageUrl,
  type Crumb,
} from "../lib/seo";
import type { Artwork } from "../lib/types";

interface Props {
  title: string;
  description: string;
  /** Painting used as share image; defaults to the home hero. */
  shareWork?: Artwork | undefined;
  /** Breadcrumbs after Home, e.g. [{ name: "Art", path: "/art/" }]. */
  breadcrumbs?: Crumb[];
  jsonLd?: object[];
  /** Image to preload (hero). */
  preload?: { srcset: string; sizes: string; type: string } | undefined;
  noindex?: boolean;
}

const { title, description, breadcrumbs, jsonLd = [], preload, noindex = false } = Astro.props;
const content = await getContent();
const share =
  Astro.props.shareWork ?? findArtwork(content, content.pages.hero.artworkSlug) ?? content.artworks[0];
const shareUrl = share && !share.placeholder ? await shareImageUrl(share.image, true) : undefined;
const shareAlt = share ? `${share.title} by ${artistOf(content, share).name}, ${share.medium.toLowerCase()}` : "";
const canonical = absoluteUrl(Astro.url.pathname);
const structured = [
  galleryJsonLd(content.gallery),
  ...(breadcrumbs ? [breadcrumbJsonLd([{ name: "Home", path: "/" }, ...breadcrumbs])] : []),
  ...jsonLd,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {
      preload && (
        <link
          rel="preload"
          as="image"
          imagesrcset={preload.srcset}
          imagesizes={preload.sizes}
          type={preload.type}
          fetchpriority="high"
        />
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={content.gallery.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    {
      shareUrl && (
        <>
          <meta property="og:image" content={shareUrl} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={shareAlt} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {
      shareUrl && (
        <>
          <meta name="twitter:image" content={shareUrl} />
          <meta name="twitter:image:alt" content={shareAlt} />
        </>
      )
    }

    {structured.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header content={content} />
    <main id="main">
      <slot />
    </main>
    <Footer content={content} />
  </body>
</html>
