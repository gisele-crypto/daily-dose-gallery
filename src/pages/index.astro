---
import { Picture, getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import Newsletter from "../components/Newsletter.astro";
import WorkImage from "../components/WorkImage.astro";
import WorkCaption from "../components/WorkCaption.astro";
import TallRow from "../components/TallRow.astro";
import {
  artistOf,
  artistUrl,
  findArtwork,
  formatOf,
  getContent,
  groupWorks,
  sizeLabel,
} from "../lib/content";
import { srcProps } from "../lib/image";

const content = await getContent();
const hero = findArtwork(content, content.pages.hero.artworkSlug) ?? content.artworks[0];
if (!hero) throw new Error("No artworks");
const heroArtist = artistOf(content, hero);

const featured = content.artworks.filter((w) => w.featuredOnHome);
const tallUnits = groupWorks(featured.filter((w) => formatOf(w) === "tall"))[0]?.units ?? [];
const large = featured.filter((w) => formatOf(w) !== "tall");

// Wide 16:8 crop of the hero painting, centred on its hotspot when set.
const heroSizes = "(min-width: 1440px) 1325px, 92vw";
const heroWidths = [640, 960, 1280, 1600].filter((w) => w <= hero.image.width);
const heroOpts = {
  ...srcProps(hero.image),
  width: Math.min(1600, hero.image.width),
  height: Math.round(Math.min(1600, hero.image.width) / 2),
  fit: "cover" as const,
  position: hero.focus ?? "center",
  widths: heroWidths.length ? heroWidths : [hero.image.width],
};
const heroPreload = await getImage({ ...heroOpts, format: "avif" });
const about = content.pages.about.sections[0];
---

<Base
  title="Daily Dose Gallery — Contemporary paintings in Blaricum, the Netherlands"
  description="Daily Dose Gallery in Blaricum, Het Gooi: contemporary paintings by Julián Villafañe. View the work online or visit us on Tuesday and Thursday."
  shareWork={hero}
  preload={{ srcset: heroPreload.srcSet.attribute, sizes: heroSizes, type: "image/avif" }}
>
  <section class="container hero" aria-labelledby="featured-artist">
    <a href={artistUrl(heroArtist)} class="hero-image" tabindex="-1" aria-hidden="true">
      <Picture
        {...heroOpts}
        formats={["avif"]}
        fallbackFormat="webp"
        sizes={heroSizes}
        alt=""
        loading="eager"
        fetchpriority="high"
      />
    </a>
    <div class="split hero-text">
      <p class="label">{content.pages.hero.label}</p>
      <div>
        <h1 class="statement" id="featured-artist">{heroArtist.name}</h1>
        <p class="hero-meta muted">
          {hero.title} · {hero.medium} · <span class="nowrap">{sizeLabel(hero)}</span>
        </p>
        <a class="link" href={artistUrl(heroArtist)}>View artist</a>
      </div>
    </div>
  </section>

  <section class="container section" aria-labelledby="art-label">
    <div class="split">
      <h2 class="label" id="art-label">Art</h2>
      <div>
        {tallUnits.length > 0 && <TallRow content={content} units={tallUnits} />}
        {tallUnits.length > 0 && large.length > 0 && <hr class="rule divider" />}
        {
          large.map((work) => (
            <div class="large">
              <WorkImage
                work={work}
                artistName={artistOf(content, work).name}
                sizes="(min-width: 900px) 640px, 92vw"
                widths={[480, 640, 960, 1280]}
              />
              <WorkCaption content={content} work={work} artist={artistOf(content, work)} />
            </div>
          ))
        }
        <a class="link all-works" href="/art/">All works</a>
      </div>
    </div>
  </section>

  {
    about && (
      <section class="container section" aria-labelledby="about-label">
        <div class="split">
          <h2 class="label" id="about-label">About</h2>
          <div>
            <p class="statement">{about.statement}</p>
            <div class="body about-text">
              {about.paragraphs.map((p) => <p>{p}</p>)}
            </div>
            <a class="link" href="/about/">Read more</a>
          </div>
        </div>
      </section>
    )
  }

  <Newsletter />
</Base>

<style>
  .hero {
    padding-top: 8px;
  }
  .hero-image {
    display: block;
  }
  .hero-image :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    object-fit: cover;
  }
  .hero-text {
    padding-top: 32px;
  }
  .hero-meta {
    margin: 12px 0 8px;
    font-size: 15px;
  }
  .nowrap {
    white-space: nowrap;
  }
  .divider {
    margin: 64px 0;
  }
  .large + .large {
    margin-top: 64px;
  }
  .large {
    display: grid;
    gap: 0 32px;
    align-items: end;
  }
  @media (min-width: 768px) {
    .large {
      grid-template-columns: minmax(0, 640px) minmax(200px, 1fr);
    }
  }
  .all-works {
    margin-top: 48px;
  }
  .about-text {
    margin: 32px 0 16px;
  }
</style>
