---
import Base from "../../layouts/Base.astro";
---

<Base
  noindex
  title="Thank you — Daily Dose Gallery"
  description="Thank you for subscribing to the newsletter of Daily Dose Gallery in Blaricum, Het Gooi. You're on the list."
>
  <section class="container intro">
    <div class="split">
      <p class="label">Newsletter</p>
      <div>
        <h1 class="statement">Thank you. You're on the list.</h1>
        <a class="link back" href="/">Back to home</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .intro {
    padding-top: 24px;
  }
  .back {
    margin-top: 24px;
  }
</style>
